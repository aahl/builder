<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF0B0B0D"
    android:orientation="vertical"
    android:paddingStart="48dp"
    android:paddingTop="28dp"
    android:paddingEnd="48dp"
    android:paddingBottom="28dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/studyProgress"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#FF8A8A94"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/studyMeta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FF8A8A94"
            android:textSize="18sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/studyQuestion"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:lineSpacingMultiplier="1.15"
        android:maxLines="4"
        android:textColor="#FFF2F2F5"
        android:textSize="34sp" />

    <LinearLayout
        android:id="@+id/studyOptions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

    <TextView
        android:id="@+id/studyFeedback"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:minHeight="32dp"
        android:textColor="@color/study_ok"
        android:textSize="20sp" />
</LinearLayout>
